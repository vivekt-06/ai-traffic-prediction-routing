# Placeholders only. The app needs NO API keys: Open-Meteo (non-commercial) and OpenStreetMap tiles are key-less.
# Optional overrides:
DATABASE_PATH=data/app.db
WEATHER_LAT=28.6139
WEATHER_LON=77.2090
WEATHER_TTL_SECONDS=1800
HTTP_TIMEOUT_SECONDS=8
# Frontend (frontend/.env): alternative tile server, e.g. a provider you have the right to use
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Reserved for a FUTURE licensed live-traffic provider (not used by this app):
# TRAFFIC_API_KEY=your-key-here
